


NODE_ENV=development
PORT=3000

# ---- Database (PostgreSQL: Neon, Supabase, ...) ----
# Use the POOLED connection string on Vercel (Neon: host contains "-pooler").
DATABASE_URL=
# Optional DIRECT (non-pooled) string, used only by "npm run db:migrate".
DATABASE_URL_DIRECT=
# Connections per running instance (default 5 locally, 3 on Vercel).
DB_POOL_MAX=5

# ---- Secrets ----
# HMACs the 6-digit codes. 32+ characters. Make a NEW one for production:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_CODE_SECRET=
# Protects /api/internal/purge (daily cleanup by Vercel Cron). 16+ characters. Optional.
CRON_SECRET=

# ---- Email ----
# resend | smtp | console (console = development ONLY; the server refuses to start in production)
# Leave empty to auto-detect: RESEND_API_KEY, then SMTP_*, then console.
MAIL_MODE=console
# With Resend the sender must be on a domain you verified there.
MAIL_FROM="AI Education <no-reply@example.com>"
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# ---- Web & proxy ----

# Number of reverse proxies in front of the app. 1 on Vercel (also the default there).
TRUST_PROXY=0