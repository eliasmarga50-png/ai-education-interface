NODE_ENV=development
PORT=3001
# Same Neon/Supabase database the auth backend uses (tables do not collide).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Optional: non-pooled connection used only by db:migrate and db:seed.
DATABASE_URL_DIRECT=
DB_POOL_MAX=5
# Comma-separated origins. Native apps need none; Flutter web needs its origin.
CORS_ORIGIN=
# Number of reverse proxies in front of the app (0 = none).
TRUST_PROXY=0
THROTTLE_LIMIT=120
THROTTLE_TTL_SECONDS=60
# error | warn | log | debug | verbose
LOG_LEVEL=log